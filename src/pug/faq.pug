include _components/_config.pug

- var PAGE_TITLE = "";

-
  const faqItems = [
      {
        q: '薬剤師会とは何をしている団体ですか？',
        a: `<p>地域の薬剤師が連携し、市民の健康を守るための研修、情報提供、災害支援などを行う職能団体です。</p>`
      },
      {
        q: '薬局の薬剤師はどんな仕事をしているのですか？',
        a: `<p>調剤だけでなく、薬の安全確認、健康相談、在宅訪問、地域の健康づくりなど幅広く活動しています。</p>`
      },
      {
        q: '市販薬と処方薬の違いは何ですか？',
        a: `<p>市販薬は自分で購入でき、軽度な症状に使用します。処方薬は医師の診察が必要で、症状に合わせて処方されます。</p>`
      },
      {
        q: '処方箋の有効期限はどれくらいですか？',
        a: `<p>処方箋の有効期限は、処方箋が発行された日を含めて4日間です。有効期限を過ぎた処方箋では調剤できませんので、できるだけ早めに薬局へお持ちください。</p><p>有効期限を過ぎてしまった場合は、処方した医療機関を再度受診し、新しい処方箋を発行してもらう必要があります。事情がある場合は、まず医療機関または薬局に相談してください。</p>`
      },
      {
        q: '薬の飲み合わせが心配なときはどこに相談すればいいですか？',
        a: `<p>薬局の薬剤師に相談できます。市販薬・処方薬・サプリメントの組み合わせも確認できます。</p>`
      },
      {
        q: '夜間や休日に薬のことで困った場合はどうすればいいですか？',
        a: `<p>地域の夜間・休日対応薬局や相談窓口を利用できます。急な副作用や不安がある場合は薬剤師に相談できます。</p>`
      },
      {
        q: '災害時に薬がなくなったらどうすればいいですか？',
        a: `<p>避難所に薬剤師が派遣される場合があります。お薬手帳があるとスムーズに対応できます。</p>`
      },
      {
        q: 'お薬手帳はなぜ必要なのですか？',
        a: `<p>薬の重複や危険な飲み合わせを防ぐためです。複数の医療機関を受診していても安全に確認できます。</p>`
      },
      {
        q: 'ジェネリック医薬品は安全ですか？',
        a: `<p>国の基準を満たしており、品質・効果・安全性が確認されています。</p>`
      },
      {
        q: '薬局で健康相談だけしてもいいのですか？',
        a: `<p>可能です。薬のことだけでなく、生活習慣や受診の目安なども相談できます。</p>`
      },
      {
        q: '在宅医療で薬剤師はどんなことをしてくれますか？',
        a: `<p>自宅や施設で薬の管理、副作用チェック、飲み方の工夫などを行い、医療チームと連携します。</p>`
      },
      {
        q: '薬は水以外の飲み物で飲んでも大丈夫ですか？',
        a: `<p>基本は水で飲むことが推奨されます。お茶・ジュース・牛乳などは薬の吸収に影響する場合があります。</p>`
      },
      {
        q: '薬を飲み忘れたときはどうすればいいですか？',
        a: `<p>薬の種類によって対応が異なります。自己判断せず、薬局で薬剤師に相談してください。</p>`
      },
      {
        q: '妊娠中・授乳中でも薬を使っていいのですか？',
        a: `<p>使える薬と避けるべき薬があります。妊娠・授乳中であることを薬剤師に伝えて相談してください。</p>`
      },
      {
        q: '子どもに市販薬を使っても大丈夫ですか？',
        a: `<p>年齢や体重によって使える薬が異なります。子ども用の薬でも注意が必要な場合があります。</p>`
      },
      {
        q: 'サプリメントは薬と一緒に飲んでも問題ありませんか？',
        a: `<p>一部のサプリメントは薬の効果に影響することがあります。併用は薬剤師に確認するのが安全です。</p>`
      },
      {
        q: '薬の保管方法で気をつけることはありますか？',
        a: `<p>高温多湿を避け、子どもの手の届かない場所に保管してください。冷蔵保存が必要な薬もあります。</p>`
      },
      {
        q: '使用期限が切れた薬は使ってもいいですか？',
        a: `<p>安全性が保証されないため使用は避けてください。薬局で回収している地域もあります。</p>`
      },
      {
        q: '薬局ごとに薬の値段は違うのですか？',
        a: `<p>市販薬は店舗によって価格が異なりますが、処方薬は全国共通のルールに基づいています。</p>`
      },
      {
        q: 'かかりつけ薬剤師とは何ですか？',
        a: `<p>薬の管理や健康相談を継続的にサポートする薬剤師のことです。複数の医療機関を利用する方に特に有用です。</p>`
      }
    ]


mixin faqItem(item, name)
  details.p-details-primary.js-details(name=name)
    summary.p-details-primary__summary.js-summary
      | #{item.q}
      .p-details-primary__icon
    .p-details-primary__content.js-content
      .p-details-primary__content-inner
        != item.a


doctype
html(lang="ja")
  head
    include _components/_head.pug
  body
    <!--#include virtual="/_includes/header.html"-->
      main.l-main
        .l-main__header
          header.p-header-primary.u-inner
            .p-header-primary__sub 市民の皆様へ
            .p-header-primary__main よくある質問
            .p-header-primary__pic.p-header-primary__pic--public
                img.u-img-radius(src="/assets/img/public-visual@2x.webp", srcset="/assets/img/public-visual.webp 1x, /assets/img/public-visual@2x.webp 2x, ", alt="")
        .l-main__contents 
          section.p-section-primary
            .p-section-primary__item.u-inner
              each item in faqItems
                +faqItem(item,"public")

    <!--#include virtual="/_includes/footer.html"-->
    <!--#include virtual="/_includes/footer-include.html"-->


